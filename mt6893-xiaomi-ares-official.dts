/* CAMERA EEPROM */
/* 0 main, 1 sub, 2 main2, 3 sub2, 4 main3 */
&i2c2 {
	mtk_camera_eeprom0: eeprom@51 {
		/* 原厂 mediatek,camera_eeprom（相机 OTP）；容量可用 size 覆盖 */
		compatible = "atmel,24c16";
		reg = <0x51>;
		status = "okay";
	};
};
&i2c4 {
	mtk_camera_eeprom1: eeprom@51 {
		/* 原厂 mediatek,camera_eeprom（相机 OTP）；容量可用 size 覆盖 */
		compatible = "atmel,24c16";
		reg = <0x51>;
		status = "okay";
	};

	mtk_camera_eeprom4: eeprom@51 {
		/* 原厂 mediatek,camera_eeprom（相机 OTP）；容量可用 size 覆盖 */
		compatible = "atmel,24c16";
		reg = <0x51>;
		status = "okay";
	};

};
